<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="icon" href="/images/logo.png" type="image/x-icon">
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
</head>
<body style="background-color: #395f48; padding-top:90px; display: flex; min-height: 100vh; flex-direction: column;">
    <nav class="navbar navbar-dark navbar-expand-lg mb-4 fixed-top shadow"
        style="background-color:#212922; padding-top:.25rem; padding-bottom:.25rem; height:65px;">

        <div class="container-fluid justify-content-start" style="margin-left:10px;">

            <% const userQuery = (currentUser && currentUser.userId) ? ("?userId=" + currentUser.userId) : ""; %>
            <% const role = (currentUser && currentUser.role) || null; %>
            <a class="navbar-brand d-flex align-items-center" href="/home-34076352<%= userQuery %>">
                <img src="/images/logo.png" alt="Recipe Hub logo" style="height:45px; width:auto; margin-right:5px;">
                <strong>Recipe Hub</strong>
            </a>

            <ul class="navbar-nav flex-row ms-3 gap-1.4 align-items-center">

                <li class="nav-item">
                    <a class="nav-link" href="/home-34076352<%= userQuery %>">Home</a>
                </li>

                <% if (role === "chef") { %>
                  <li class="nav-item dropdown">
                      <a class="nav-link dropdown-toggle" href="#" id="recipesDropdown" role="button"
                          data-bs-toggle="dropdown">
                          Recipes
                      </a>
                      <ul class="dropdown-menu dropdown-menu-dark">
                          <li><a class="dropdown-item" href="/recipes-34076352<%= userQuery %>">View Recipes</a></li>
                          <li><a class="dropdown-item" href="/recipes-add-34076352<%= userQuery %>">Add Recipe</a></li>
                      </ul>
                  </li>
                <% } %>

                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="inventoryDropdown" role="button"
                        data-bs-toggle="dropdown">
                        Inventory
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark">
                        <li><a class="dropdown-item" href="/inventory-34076352<%= userQuery %>">View Inventory</a></li>
                        <li><a class="dropdown-item" href="/inventory-add-34076352<%= userQuery %>">Add Inventory</a></li>
                    </ul>
                </li>

                  <li class="nav-item dropdown">
                      <a class="nav-link dropdown-toggle" href="#" id="hdTasksDropdown" role="button"
                          data-bs-toggle="dropdown">
                          HD Task
                      </a>
                      <ul class="dropdown-menu dropdown-menu-dark">
                          <% if (role === "chef") { %>
                            <li><a class="dropdown-item" href="/smart-recipe-recommendations-34076352<%= userQuery %>">Smart Recipe Recommendations (HD 1)</a></li>
                            <% } %>

                        <li><a class="dropdown-item" href="/recipes-filter-34076352<%= userQuery %>">Updated Search & Filter (HD 3)</a></li>

                        <% if (role === "admin") { %>
                        <li><a class="dropdown-item" href="/recipe-analytics-dashboard-34076352<%= userQuery %>">Advanced Recipe Analytics Dashboard (HD 3)</a></li>

                        <li><a class="dropdown-item" href="/smart-inventory-management-34076352<%= userQuery %>">Smart Inventory Management (HD 4)</a></li>
                        
                        <% } %>
                      </ul>
                  </li>

            </ul>

            <div class="d-flex align-items-center ms-auto me-3" style="color: rgb(180, 180, 180); font-size: 0.85rem;">
              <% if (currentUser) { %>
                <span class="me-2">Welcome, <strong><%= currentUser.fullname %></strong> (<%= currentUser.email %>)</span>
                <a class="btn btn-sm btn-outline-light" href="/logout-34076352<%= userQuery %>">Logout</a>
              <% } else { %>
                <a class="btn btn-sm btn-outline-light" href="/login-34076352">Login</a>
              <% } %>
            </div>
        </div>
    </nav>

    <main class="container flex-grow-1">
    <!-- Main content of the page -->
